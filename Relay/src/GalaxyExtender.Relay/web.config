<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the relay. `dotnet publish` rewrites processPath/arguments in the published
  copy, so leave those as-is here.

  stdoutLogEnabled is the escape hatch for a failed start: if the app 500.30s on the host, set it
  to "true", reproduce, read App_Data\logs\stdout_*.log, then set it back to "false". It is off by
  default because it grows without bound and Serilog's file sink covers normal operation.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\GalaxyExtender.Relay.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\App_Data\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!-- Matches the 32 KB app-level limit; rejects oversize bodies at the IIS edge. -->
          <requestLimits maxAllowedContentLength="32768" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
